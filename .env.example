# ---------------------------------------------------------------------------
# AI twin (server-only). Copy this file to .env.local and restart the dev server.
# Never prefix the key with NEXT_PUBLIC_ — that would ship it to the browser.
# ---------------------------------------------------------------------------

# offline  → always use the labelled fallback (works with no key)
# gemini   → use Google AI Studio
# unset    → Gemini if GEMINI_API_KEY exists, otherwise offline
AI_PROVIDER=offline

# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Site metadata (public). Absolute URL with no trailing slash.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
